{
  "name": "dbpcms",
  "version": "0.1.0",
  "private": true,
  "description": "Donna Barbar Polytechnic College Management System",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@dbpcms/api",
    "dev:web": "npm run dev --workspace=@dbpcms/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "npm run prisma:generate --workspace=@dbpcms/api",
    "db:migrate": "npm run prisma:migrate --workspace=@dbpcms/api",
    "db:seed": "npm run prisma:seed --workspace=@dbpcms/api",
    "db:studio": "npm run prisma:studio --workspace=@dbpcms/api",
    "db:reset": "npm run prisma:reset --workspace=@dbpcms/api",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "DBPCMS Team",
  "license": "UNLICENSED"
}
