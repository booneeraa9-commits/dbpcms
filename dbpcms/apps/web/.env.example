VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=DBPCMS

# Set to "true" to use browser localStorage as a fake backend.
# This lets you explore the full UI without needing a real database.
# When you have a real backend, set this to "false" (or remove it)
# and the real API takes over. Zero code changes needed.
VITE_MOCK_MODE=true
