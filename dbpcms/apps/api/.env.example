# ──────────────────────────────────────────────────────
# DBPCMS Backend API — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the .env file.
# ──────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Database
DATABASE_URL=postgresql://dbpcms:dbpcms_dev_password@localhost:5432/dbpcms

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_me_with_another_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info

# File uploads
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# Application
APP_NAME=DBPCMS
APP_URL=http://localhost:4000
WEB_URL=http://localhost:5173
