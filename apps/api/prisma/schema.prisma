// DBPCMS database schema (Prisma).
// This file is the single blueprint for the database structure. Running
// `prisma migrate` turns changes here into versioned SQL that builds the
// database identically on every machine (your laptop and the VPS).
//
// Phase 2 introduces Identity & Access tables. Later phases add employees,
// students, grading, etc. — each as a new migration, without touching these.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A login identity. Not every employee is a user, and not every user is an
/// employee, so users are kept separate (a link to Employee is added later).
model User {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  /// The password is never stored in plain text — only its argon2 hash.
  passwordHash String @map("password_hash")

  fullName String  @map("full_name")
  isActive Boolean @default(true) @map("is_active")

  /// Force a password change on next login (used for seeded/reset accounts).
  mustChangePassword Boolean @default(false) @map("must_change_password")

  /// Account-lockout tracking (brute-force protection).
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")

  /// Bumping this number instantly invalidates all existing access tokens
  /// (used on logout-all, password change, or admin action).
  tokenVersion Int @default(0) @map("token_version")

  lastLoginAt DateTime? @map("last_login_at")

  roles                 UserRole[]
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  instructorAssignments InstructorAssignment[] @relation("InstructorAssignments")

  // Standard audit columns present on every table.
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([email])
  @@map("users")
}

/// A named bundle of permissions (e.g. "instructor").
model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?
  /// System roles cannot be deleted through the UI (protects built-ins).
  isSystem    Boolean @default(false) @map("is_system")

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

/// One fine-grained ability, e.g. "grade:approve". Code checks these.
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

/// Join table: a user has many roles; a role has many users.
model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Join table: a role has many permissions; a permission belongs to many roles.
model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A stored refresh-token session. Storing a HASH of the token (never the raw
/// token) lets us revoke sessions and survive a database leak safely.
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// ACADEMIC STRUCTURE (Phase 3)
// Departments → Programs → Courses, plus Academic Years → Semesters.
// These are the foundation the Employee and Grading modules build upon.
// ============================================================================

/// An academic department (e.g. Engineering, Business).
model Department {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  code        String  @unique
  description String?
  isActive    Boolean @default(true) @map("is_active")

  programs  Program[]
  employees Employee[] @relation("DepartmentEmployees")
  students  Student[]  @relation("DepartmentStudents")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([code])
  @@index([isActive])
  @@map("departments")
}

/// A program of study belonging to a department (e.g. BSc in Software Eng.).
model Program {
  id            String  @id @default(uuid()) @db.Uuid
  departmentId  String  @map("department_id") @db.Uuid
  name          String
  code          String  @unique
  degreeLevel   String  @map("degree_level") // e.g. Diploma, Degree
  durationYears Int     @map("duration_years")
  isActive      Boolean @default(true) @map("is_active")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  students   Student[]  @relation("ProgramStudents")
  courses    Course[]   @relation("ProgramCourses")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([departmentId])
  @@index([code])
  @@map("programs")
}

/// An academic year, e.g. "2026/2027". Exactly one can be the current year.
model AcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")

  semesters Semester[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([isCurrent])
  @@map("academic_years")
}

/// A semester within an academic year.
model Semester {
  id             String   @id @default(uuid()) @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  name           String // e.g. "Semester I"
  sequence       Int // 1, 2, 3…
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  status         String   @default("planned") // planned | active | closed

  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  sections     Section[]    @relation("SemesterSections")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@unique([academicYearId, sequence])
  @@index([academicYearId])
  @@map("semesters")
}

// ============================================================================
// EMPLOYEE MANAGEMENT (Phase 4)
// ============================================================================

/// The master HR record for an employee. Not linked to a login by default.
model Employee {
  id             String  @id @default(uuid()) @db.Uuid
  employeeNumber String  @unique @map("employee_number")

  // --- Personal ---
  firstName     String   @map("first_name")
  middleName    String?  @map("middle_name")
  lastName      String   @map("last_name")
  gender        String
  dateOfBirth   DateTime @map("date_of_birth") @db.Date
  nationality   String?
  maritalStatus String?  @map("marital_status")
  nationalId    String   @map("national_id")
  taxId         String?  @map("tax_id")
  phoneNumber   String   @map("phone_number")
  email         String
  address       String?

  // --- Employment ---
  departmentId     String    @map("department_id") @db.Uuid
  position         String
  employmentType   String    @map("employment_type") // full_time | part_time | contract
  contractType     String?   @map("contract_type")
  employmentStatus String    @map("employment_status") // active | on_leave | suspended | terminated | retired
  dateOfEmployment DateTime  @map("date_of_employment") @db.Date
  contractEndDate  DateTime? @map("contract_end_date") @db.Date
  salaryGrade      String?   @map("salary_grade")
  officeLocation   String?   @map("office_location")
  supervisorId     String?   @map("supervisor_id") @db.Uuid
  photoStorageKey  String?   @map("photo_storage_key")

  department Department @relation("DepartmentEmployees", fields: [departmentId], references: [id], onDelete: Restrict)
  supervisor Employee?  @relation("EmployeeSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  reports    Employee[] @relation("EmployeeSupervisor")

  education         EmployeeEducation[]
  qualifications    EmployeeQualification[]
  employmentHistory EmploymentHistory[]
  emergencyContacts EmergencyContact[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([employeeNumber])
  @@index([departmentId])
  @@index([employmentStatus])
  @@index([lastName, firstName])
  @@map("employees")
}

/// One education entry for an employee (many per employee).
model EmployeeEducation {
  id             String  @id @default(uuid()) @db.Uuid
  employeeId     String  @map("employee_id") @db.Uuid
  institution    String
  qualification  String
  fieldOfStudy   String? @map("field_of_study")
  graduationYear Int?    @map("graduation_year")
  gpa            String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("employee_education")
}

/// A professional qualification: certification, license, workshop, training, or membership.
model EmployeeQualification {
  id           String    @id @default(uuid()) @db.Uuid
  employeeId   String    @map("employee_id") @db.Uuid
  type         String // certification | license | workshop | training | membership
  title        String
  issuer       String?
  issueDate    DateTime? @map("issue_date") @db.Date
  expiryDate   DateTime? @map("expiry_date") @db.Date
  referenceNo  String?   @map("reference_no")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("employee_qualifications")
}

/// A previous-employment record (before joining the college).
model EmploymentHistory {
  id              String    @id @default(uuid()) @db.Uuid
  employeeId      String    @map("employee_id") @db.Uuid
  employer        String
  position        String
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  responsibilities String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("employment_history")
}

/// An emergency contact for an employee (many per employee).
model EmergencyContact {
  id           String  @id @default(uuid()) @db.Uuid
  employeeId   String  @map("employee_id") @db.Uuid
  name         String
  relationship String?
  phoneNumber  String  @map("phone_number")
  address      String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([employeeId])
  @@map("emergency_contacts")
}

/// Per-year counter to generate sequential, never-reused employee numbers.
model EmployeeNumberSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("employee_number_sequences")
}

/// Admin-editable configuration, stored as key/value so business rules (e.g.
/// retirement age, contract-expiry window) can change WITHOUT code changes.
model SystemSetting {
  key         String  @id
  value       String
  description String?
  updatedBy   String? @map("updated_by") @db.Uuid

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

/// A verification record for an officially issued/printed document. The public
/// verification lookup checks a code here to confirm a printout is genuine.
model DocumentVerification {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique // short human-readable code, also encoded in the QR
  documentKind String   @map("document_kind") // "employee_profile" (future: "transcript", ...)
  subjectType  String   @map("subject_type") // "employee"
  subjectId    String   @map("subject_id") @db.Uuid
  subjectLabel String   @map("subject_label") // e.g. name + employee number, for display
  issuedBy     String?  @map("issued_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([subjectType, subjectId])
  @@map("document_verifications")
}

/// Metadata for an uploaded file. The actual bytes live in the storage provider
/// (local disk now, cloud later) referenced by storageKey. ownerType/ownerId
/// make this table reusable for students, etc., in future modules.
model Document {
  id               String  @id @default(uuid()) @db.Uuid
  ownerType        String  @map("owner_type") // "employee" (future: "student", ...)
  ownerId          String  @map("owner_id") @db.Uuid
  documentType     String  @map("document_type") // degree | cv | national_id | ...
  originalFilename String  @map("original_filename")
  storageKey       String  @map("storage_key") // path/key the StorageProvider understands
  mimeType         String  @map("mime_type")
  sizeBytes        Int     @map("size_bytes")
  checksum         String?
  uploadedBy       String? @map("uploaded_by") @db.Uuid

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([ownerType, ownerId])
  @@map("documents")
}

// ============================================================================
// STUDENT ACADEMIC MANAGEMENT (Phase 5)
// Students, Courses, Sections (a course offered in a semester), Instructor
// assignments, and Enrollments (a student taking a section).
// ============================================================================

/// A student record. Not linked to a login by default (self-service is future).
model Student {
  id            String  @id @default(uuid()) @db.Uuid
  studentNumber String  @unique @map("student_number")

  firstName  String  @map("first_name")
  middleName String? @map("middle_name")
  lastName   String  @map("last_name")
  gender     String
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  email       String?
  phoneNumber String?  @map("phone_number")

  departmentId      String  @map("department_id") @db.Uuid
  programId         String  @map("program_id") @db.Uuid
  batch             String? // e.g. "2026 intake"
  section           String? // free-text class section label, e.g. "A"
  currentSemesterId String? @map("current_semester_id") @db.Uuid
  status            String  @default("active") // active | graduated | withdrawn | suspended

  department Department @relation("DepartmentStudents", fields: [departmentId], references: [id], onDelete: Restrict)
  program    Program    @relation("ProgramStudents", fields: [programId], references: [id], onDelete: Restrict)

  enrollments Enrollment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([studentNumber])
  @@index([departmentId])
  @@index([programId])
  @@index([status])
  @@index([lastName, firstName])
  @@map("students")
}

/// Per-year counter for sequential, never-reused student numbers.
model StudentNumberSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("student_number_sequences")
}

/// A course in the catalog.
model Course {
  id           String  @id @default(uuid()) @db.Uuid
  programId    String? @map("program_id") @db.Uuid
  code         String  @unique
  title        String
  creditHours  Int     @map("credit_hours")
  category     String? // e.g. Core, Elective, Common
  isActive     Boolean @default(true) @map("is_active")

  program  Program?  @relation("ProgramCourses", fields: [programId], references: [id], onDelete: SetNull)
  sections Section[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@index([code])
  @@index([programId])
  @@map("courses")
}

/// A course offered in a specific semester, as a section (A/B/...).
model Section {
  id           String @id @default(uuid()) @db.Uuid
  courseId     String @map("course_id") @db.Uuid
  semesterId   String @map("semester_id") @db.Uuid
  sectionLabel String @map("section_label") // e.g. "A"
  capacity     Int?

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester Semester @relation("SemesterSections", fields: [semesterId], references: [id], onDelete: Restrict)

  instructors InstructorAssignment[]
  enrollments Enrollment[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version   Int       @default(0)

  @@unique([courseId, semesterId, sectionLabel])
  @@index([semesterId])
  @@index([courseId])
  @@map("sections")
}

/// Links an instructor (a User) to a section they teach.
model InstructorAssignment {
  id           String @id @default(uuid()) @db.Uuid
  sectionId    String @map("section_id") @db.Uuid
  instructorId String @map("instructor_id") @db.Uuid

  section    Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  instructor User    @relation("InstructorAssignments", fields: [instructorId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  @@unique([sectionId, instructorId])
  @@index([instructorId])
  @@map("instructor_assignments")
}

/// A student enrolled in a section (this is where grades will attach in Phase 6).
model Enrollment {
  id            String @id @default(uuid()) @db.Uuid
  studentId     String @map("student_id") @db.Uuid
  sectionId     String @map("section_id") @db.Uuid
  status        String @default("enrolled") // enrolled | completed | withdrawn | incomplete | audit
  attemptNumber Int    @default(1) @map("attempt_number")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@unique([studentId, sectionId, attemptNumber])
  @@index([sectionId])
  @@index([studentId])
  @@map("enrollments")
}

// ============================================================================
// GRADING CONFIGURATION (Phase 6) — all editable in the UI, no code changes.
// Scales, components, and GPA rules are VERSIONED and SCOPED (null department =
// college-wide default; a department id = that department's override later).
// ============================================================================

/// A named grading scale (e.g. "Standard 4.0"). Its letter bands live in
/// GradingScaleBand. Versioning lets old published grades keep their scale.
model GradingScale {
  id           String  @id @default(uuid()) @db.Uuid
  name         String
  departmentId String? @map("department_id") @db.Uuid // null = college-wide
  version      Int     @default(1)
  isActive     Boolean @default(true) @map("is_active")
  passMark     Float   @default(50) @map("pass_mark") // % at/above which a student passes
  rounding     String  @default("half_up") // half_up | truncate | nearest

  bands GradingScaleBand[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([departmentId])
  @@map("grading_scales")
}

/// One letter band within a grading scale (e.g. 90-100 = A+ = 4.0, pass).
model GradingScaleBand {
  id         String  @id @default(uuid()) @db.Uuid
  scaleId    String  @map("scale_id") @db.Uuid
  minPercent Float   @map("min_percent")
  maxPercent Float   @map("max_percent")
  letter     String
  gradePoint Float   @map("grade_point")
  isPass     Boolean @default(true) @map("is_pass")

  scale GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@index([scaleId])
  @@map("grading_scale_bands")
}

/// A configurable grade component (Quiz, Mid, Final…) with a weight percentage.
/// Grouped by componentSetName + scope; weights within a set should sum to 100.
model GradeComponent {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  weightPercent  Float   @map("weight_percent")
  sequence       Int     @default(0)
  departmentId   String? @map("department_id") @db.Uuid // null = college-wide
  isActive       Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")

  @@index([departmentId])
  @@map("grade_components")
}

/// Append-only diary of critical actions: who did what, when, from where.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}
