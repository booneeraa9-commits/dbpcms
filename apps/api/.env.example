# -----------------------------------------------------------------------------
# DBPCMS API environment template.
# COPY this file to ".env" and fill in real values. NEVER commit the real .env.
# On Windows PowerShell:  Copy-Item .env.example .env
# -----------------------------------------------------------------------------

# Which environment we're running in: development | test | production
NODE_ENV=development

# Port the backend API listens on
PORT=4000

# Full PostgreSQL connection string.
# Matches the docker-compose credentials above for local development.
DATABASE_URL="postgresql://dbpcms:dbpcms_dev_password@localhost:5432/dbpcms?schema=public"

# Comma-separated list of allowed frontend origins (CORS).
CORS_ORIGINS="http://localhost:5173"

# Secrets for signing JWTs. In production, generate long random strings.
# (These placeholders are only acceptable for local development.)
JWT_ACCESS_SECRET="dev-access-secret-change-me-please-32chars-min"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-please-32chars-min"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Where uploaded documents are stored on disk (local storage provider).
# On the VPS this points to a backed-up, persistent path outside the app folder.
STORAGE_ROOT="./storage"

# First administrator, created by the seed script (decision B5).
SEED_ADMIN_EMAIL="booneeraa9@gmail.com"
SEED_ADMIN_PASSWORD="ChangeMe!Temp1234"

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"
